NEXT_PUBLIC_BASE_URL=https://www.rkabogados.cl
DISABLE_CACHE=true
NEXT_PUBLIC_ENVIRONMENT=local

# Google Tag Manager container. Defaults to the live one (GTM-PC49T6MC) when
# unset; point a staging deployment at its own container here.
NEXT_PUBLIC_GTM_ID=

# Apps Script web app that writes contact rows to the firm's Google Sheet.
# Leave empty everywhere but Vercel production: unset means logToSheet is a
# no-op, which keeps preview and local traffic out of the live log.
NEXT_PUBLIC_SHEET_WEBAPP_URL=

CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_REVALIDATE_SECRET=

DRAFT_MODE_SECRET_TOKEN=

OPENAI_API_KEY=

# DB For embeddings
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=

# Re-Captcha
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=something
RECAPTCHA_SECRET_KEY=something-key

GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GOOGLE_TARGET_CALENDAR_ID=